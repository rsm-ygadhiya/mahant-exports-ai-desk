DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mahant?schema=public"
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"

# WhatsApp deep link target (used in customer-facing pages)
MAHANT_WHATSAPP_NUMBER="919999999999"

# Storage (Cloudflare R2 — for cert PDFs / videos)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mahant-assets"

# Push notifications (FCM)
FCM_SERVER_KEY=""

# Admin notification email
ADMIN_NOTIFY_EMAIL="sales@mahantexports.com"

# OpenAI API — powers the /admin/ai pages (aging triage, morning briefing, demand forecast, etc.)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Cron auth — required header for /api/cron/pricing-tick. Set to any long random
# string in production. Leave blank in dev to allow unauthenticated ticks (the
# endpoint returns a clear warning when unset).
CRON_SECRET=""

# ─── Scintilla (M03 workflow visualizer at /admin/scintilla) ────────────
# Absolute path to the milestone-03 Python repo. Scintilla shells out to
# `uv run python scripts/orchestrator.py` and `python3 scripts/simulate/tick.py`
# in this folder.
M3_REPO_PATH="/Users/lucifer/Desktop/MSBA/Spring/Gen AI/mgt449-milestone03-Group-10"

# Password the desk owner types in the modal before Scintilla pushes a
# repricing proposal into the live Diamond inventory. Default if unset
# is "pramukh-2026" — change for any non-demo deploy.
SCINTILLA_APPROVE_PASSWORD="pramukh-2026"

# TritonAI (UCSD Claude proxy) — powers the /admin/ai/ask page.
# Get a key from your UCSD GenAI course portal.
TRITONAI_API_KEY=""
