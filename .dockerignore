# Keep the build context small + clean. Anything listed here is invisible
# to the Docker build. Don't ship dev artefacts, secrets, or local caches.

# Heavy / regenerated
**/node_modules
**/.next
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.pyc

# Secrets — env vars come from Render's dashboard, never from a baked file
**/.env
**/.env.local
**/.env.*.local

# OS / editor
.DS_Store
.vscode
.idea
.claude

# VCS
.git
.gitignore

# Docs / artefacts not needed at runtime
*.md
!ui/web/prisma/README.md
docs/
slides/
*_files/
data/working/

# This repo's own deploy artefacts (we rebuild fresh inside Docker)
Dockerfile
.dockerignore
render.yaml
